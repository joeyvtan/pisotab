{
  "name": "jjtpisotab-setup-tool",
  "version": "1.0.0",
  "description": "JJTPisoTab Desktop Setup Tool — configure kiosk tablets and flash ESP firmware",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron": "electron .",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder --win",
    "build:portable": "npm run build:renderer && electron-builder --win portable",
    "rebuild": "electron-rebuild -f -w serialport"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.10"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "lucide-react": "^0.363.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serialport": "^12.0.0"
  },
  "build": {
    "appId": "com.jjt.pisotab-setup-tool",
    "productName": "JJTPisoTab Setup Tool",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "services/**/*",
      "dist/renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/"
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "npmRebuild": true
  }
}
