<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:text="PisoTab Setup"
            android:textSize="24sp"
            android:textColor="#F1F5F9"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="Set up the basics. All other settings are available in Admin → Settings."
            android:textSize="12sp"
            android:textColor="#64748B"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"/>

        <!-- Device ID -->
        <TextView android:text="Device ID *" android:textColor="#94A3B8" android:textSize="13sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/et_device_id"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="text" android:hint="dev_abc123"
            android:background="#1E293B" android:textColor="#F1F5F9" android:textColorHint="#475569"
            android:padding="12dp" android:layout_marginBottom="4dp"/>
        <TextView android:text="Provided by your PisoTab dashboard."
            android:textColor="#475569" android:textSize="11sp"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"/>

        <!-- Device Name -->
        <TextView android:text="Device Name" android:textColor="#94A3B8" android:textSize="13sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/et_device_name"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="text" android:hint="Phone 01"
            android:background="#1E293B" android:textColor="#F1F5F9" android:textColorHint="#475569"
            android:padding="12dp" android:layout_marginBottom="16dp"/>

        <!-- Admin PIN -->
        <TextView android:text="Admin PIN" android:textColor="#94A3B8" android:textSize="13sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/et_admin_pin"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="numberPassword" android:hint="1234 (default)"
            android:background="#1E293B" android:textColor="#F1F5F9" android:textColorHint="#475569"
            android:padding="12dp" android:layout_marginBottom="32dp"/>

        <!-- Buttons -->
        <Button android:id="@+id/btn_save"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:text="Save and Continue"
            android:backgroundTint="#F97316" android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp"/>

        <Button android:id="@+id/btn_back"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:text="Back"
            android:backgroundTint="#1E293B" android:textColor="#94A3B8"/>

    </LinearLayout>
</ScrollView>
