<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Display Mode -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Display Mode" android:textColor="@color/text_secondary" android:textSize="12sp"
            android:layout_marginBottom="6dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:background="@color/card_bg" android:padding="14dp" android:layout_marginBottom="20dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Dark Mode" android:textColor="@color/text_primary" android:textSize="14sp"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_dark_mode"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:checked="true"/>
        </LinearLayout>

        <!-- Business Name -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Business Name" android:textColor="@color/text_secondary" android:textSize="12sp"
            android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/et_business_name"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:backgroundTint="@color/edit_bg" android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:hint="JJT PisoTab" android:padding="12dp" android:layout_marginBottom="20dp"/>

        <!-- Theme -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Accent Theme" android:textColor="@color/text_secondary" android:textSize="12sp"
            android:layout_marginBottom="10dp"/>
        <RadioGroup android:id="@+id/rg_theme"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="20dp">
            <RadioButton android:id="@+id/rb_theme_orange"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Orange" android:textColor="@color/text_primary" android:buttonTint="#F97316"/>
            <RadioButton android:id="@+id/rb_theme_blue"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Blue" android:textColor="@color/text_primary" android:buttonTint="#3B82F6"/>
            <RadioButton android:id="@+id/rb_theme_green"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Green" android:textColor="@color/text_primary" android:buttonTint="#22C55E"/>
        </RadioGroup>

        <!-- Idle / Lock Screen Animation -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="IDLE SCREEN ANIMATION" android:textColor="@color/text_secondary" android:textSize="11sp"
            android:letterSpacing="0.08" android:layout_marginBottom="8dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@color/card_bg"
            android:padding="14dp" android:layout_marginBottom="6dp">
            <RadioGroup android:id="@+id/rg_animation_preset"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <RadioButton android:id="@+id/rb_anim_none"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="None" android:textColor="@color/text_primary" android:textSize="14sp"
                    android:paddingTop="4dp" android:paddingBottom="4dp"/>
                <RadioButton android:id="@+id/rb_anim_coins"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="🪙 Coin Rain  —  falling coins" android:textColor="@color/text_primary" android:textSize="14sp"
                    android:paddingTop="4dp" android:paddingBottom="4dp"/>
                <RadioButton android:id="@+id/rb_anim_stars"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="🚀 Star Field  —  warp speed flythrough" android:textColor="@color/text_primary" android:textSize="14sp"
                    android:paddingTop="4dp" android:paddingBottom="4dp"/>
                <RadioButton android:id="@+id/rb_anim_circuit"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="🔌 Circuit Board  —  glowing PCB traces" android:textColor="@color/text_primary" android:textSize="14sp"
                    android:paddingTop="4dp" android:paddingBottom="4dp"/>
            </RadioGroup>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Plays on the Insert Coin and Session Expired screens."
            android:textColor="@color/text_hint" android:textSize="11sp" android:layout_marginBottom="20dp"/>

        <!-- Background Preset -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="BACKGROUND PRESET" android:textColor="@color/text_secondary" android:textSize="11sp"
            android:letterSpacing="0.08" android:layout_marginBottom="8dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@color/card_bg"
            android:padding="14dp" android:layout_marginBottom="6dp">
            <RadioGroup android:id="@+id/rg_wallpaper_preset"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <RadioButton android:id="@+id/rb_wp_custom"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Custom (use uploaded wallpaper below)" android:textColor="@color/text_primary" android:textSize="14sp"
                    android:paddingTop="4dp" android:paddingBottom="4dp"/>
                <RadioButton android:id="@+id/rb_wp_galaxy"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="🌌 Galaxy  —  deep space starfield" android:textColor="@color/text_primary" android:textSize="14sp"
                    android:paddingTop="4dp" android:paddingBottom="4dp"/>
                <RadioButton android:id="@+id/rb_wp_cyber"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="⚡ Cyber Grid  —  electric blue matrix" android:textColor="@color/text_primary" android:textSize="14sp"
                    android:paddingTop="4dp" android:paddingBottom="4dp"/>
                <RadioButton android:id="@+id/rb_wp_lava"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="🌋 Lava Core  —  molten volcanic glow" android:textColor="@color/text_primary" android:textSize="14sp"
                    android:paddingTop="4dp" android:paddingBottom="4dp"/>
            </RadioGroup>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Selecting a preset overrides the uploaded wallpaper."
            android:textColor="@color/text_hint" android:textSize="11sp" android:layout_marginBottom="20dp"/>

        <!-- Wallpaper (single) -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Wallpaper" android:textColor="@color/text_secondary" android:textSize="12sp"
            android:layout_marginBottom="8dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="8dp">
            <Button android:id="@+id/btn_pick_wallpaper"
                android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                android:text="Pick Image" android:backgroundTint="@color/edit_bg"
                android:textColor="@color/text_primary" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btn_clear_wallpaper"
                android:layout_width="wrap_content" android:layout_height="40dp"
                android:text="Clear" android:backgroundTint="#7F1D1D" android:textColor="#FFFFFF"/>
        </LinearLayout>
        <ImageView android:id="@+id/iv_wallpaper_preview"
            android:layout_width="match_parent" android:layout_height="160dp"
            android:scaleType="centerCrop" android:background="@color/card_bg"
            android:layout_marginBottom="20dp" android:visibility="gone"/>

        <!-- Lock Screen Video -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="LOCK SCREEN VIDEO (optional)" android:textColor="@color/text_secondary" android:textSize="11sp"
            android:letterSpacing="0.08" android:layout_marginBottom="6dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Pick a short video clip (up to ~30 s) to play on loop on the Insert Coin screen instead of a static wallpaper."
            android:textColor="@color/text_hint" android:textSize="11sp" android:layout_marginBottom="8dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="8dp">
            <Button android:id="@+id/btn_pick_video"
                android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                android:text="Pick Video" android:backgroundTint="@color/edit_bg"
                android:textColor="@color/text_primary" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btn_clear_video"
                android:layout_width="wrap_content" android:layout_height="40dp"
                android:text="Clear" android:backgroundTint="#7F1D1D" android:textColor="#FFFFFF"/>
        </LinearLayout>
        <TextView android:id="@+id/tv_video_name"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="No video selected" android:textColor="@color/text_hint" android:textSize="12sp"
            android:layout_marginBottom="12dp"/>

        <!-- Video delay and sound options -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@color/card_bg"
            android:padding="14dp" android:layout_marginBottom="4dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="14dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Play after (seconds)" android:textColor="@color/text_primary"
                    android:textSize="14sp"/>
                <EditText android:id="@+id/et_video_delay"
                    android:layout_width="72dp" android:layout_height="wrap_content"
                    android:inputType="number" android:gravity="center"
                    android:backgroundTint="@color/edit_bg" android:textColor="@color/text_primary"
                    android:padding="8dp" android:text="0"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="14dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Play with sound" android:textColor="@color/text_primary"
                    android:textSize="14sp"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_video_sound"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="14dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Show 'Insert Coin to Start' text" android:textColor="@color/text_primary"
                    android:textSize="14sp"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_show_insert_coin"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:checked="true"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Force landscape when video plays" android:textColor="@color/text_primary"
                    android:textSize="14sp"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_video_landscape"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Delay: seconds of animation shown before video starts. Sound: off by default."
            android:textColor="@color/text_hint" android:textSize="11sp"
            android:layout_marginBottom="24dp"/>

        <!-- Save + Reset -->
        <Button android:id="@+id/btn_save_appearance"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:text="Save Appearance" android:backgroundTint="#F97316"
            android:textColor="#FFFFFF" android:layout_marginBottom="8dp"/>
        <Button android:id="@+id/btn_reset_appearance"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:text="Reset to Defaults" android:backgroundTint="@color/edit_bg"
            android:textColor="@color/text_primary"/>

    </LinearLayout>
</ScrollView>
